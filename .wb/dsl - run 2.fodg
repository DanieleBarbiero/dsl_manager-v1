     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T7">template prompt</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P4" xml:id="id3" draw:id="id3" draw:layer="layout" svg:width="5cm" svg:height="5cm" svg:x="178cm" svg:y="109.25cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T1">slide n</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P4" xml:id="id2" draw:id="id2" draw:layer="layout" svg:width="5cm" svg:height="5cm" svg:x="178cm" svg:y="116.25cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T1">report</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P5" xml:id="id1" draw:id="id1" draw:layer="layout" svg:width="2.5cm" svg:height="2.5cm" svg:x="185cm" svg:y="114.25cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T5">template </text:span><text:span text:style-name="T5">report</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr8" draw:text-style-name="P9" draw:layer="layout" svg:width="19.5cm" svg:height="5.978cm" svg:x="166.25cm" svg:y="134.5cm">
     <draw:text-box>
      <text:p text:style-name="P8"><text:span text:style-name="T1">prompt consigliato da codex per far partire la generazione del documento di design:</text:span></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T8"/></text:p>
      <text:p text:style-name="P8"><text:span text:style-name="T8">esegui integralmente il prompt contenuto in `.kb/documenti/documenti di design/run 2/design_document_v_02_prompt.md`. Usa i file locali come input e produci esclusivamente gli output indicati dal prompt.</text:span></text:p>
     </draw:text-box>
    </draw:frame>
