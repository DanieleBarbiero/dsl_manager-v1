      "text": "CREATE PROCEDURE PRC_REGISTRA_PAGAMENTO (IN P_ID_RATA INTEGER, IN P_IMPORTO DECIMAL(12,2))\nBEGIN\n  UPDATE PRT_PAGAMENTO\n  SET ESITO = 'CONTABILIZZATO'\n  WHERE ID_RATA = P_ID_RATA;\n\n  UPDATE PRT_RATA\n  SET STATO = 'PAGATA'\n  WHERE ID_RATA = P_ID_RATA;\nEND;",
