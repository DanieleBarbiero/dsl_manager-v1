     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T1">analisi, chat, ecc.</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr4" draw:text-style-name="P5" xml:id="id10" draw:id="id10" draw:layer="layout" svg:width="2.5cm" svg:height="2.5cm" svg:x="170.25cm" svg:y="77.5cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T5">template</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:frame draw:style-name="gr5" draw:text-style-name="P4" xml:id="id8" draw:id="id8" draw:layer="layout" svg:width="6.25cm" svg:height="6cm" svg:x="171.35cm" svg:y="81.95cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T1">crea</text:span><text:span text:style-name="T1">zion</text:span><text:span text:style-name="T1">e </text:span><text:span text:style-name="T1">doc</text:span><text:span text:style-name="T1">ume</text:span><text:span text:style-name="T1">nto </text:span><text:span text:style-name="T1">di </text:span><text:span text:style-name="T1">desi</text:span><text:span text:style-name="T1">gn</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
    <draw:path draw:style-name="gr6" draw:text-style-name="P1" draw:layer="layout" svg:width="29cm" svg:height="13.393cm" draw:transform="skewX (-0.00226892802759263) rotate (-0.014835298641952) translate (160.362475319377cm 98.7859860878026cm)" svg:viewBox="0 0 29001 13394" svg:d="M24670 13099c7531-553 5965-13340-10476-13096-16442 245-17248 13507-9288 13390">
     <text:p/>
    </draw:path>
    <draw:frame draw:style-name="gr7" draw:text-style-name="P6" draw:layer="layout" svg:width="10.75cm" svg:height="25.035cm" svg:x="125cm" svg:y="71.5cm">
     <draw:text-box>
      <text:p><text:span text:style-name="T6">2026/08/31</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Hai un documento di </text:span><text:span text:style-name="T6">design</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">È quello da cui trarre i </text:span><text:span text:style-name="T6">prompt</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Su DSL, gli dico (con </text:span><text:span text:style-name="T6">prompt fisso, cambia solo il </text:span><text:span text:style-name="T6">numero) leggi il design, </text:span><text:span text:style-name="T6">scrivi la slice.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Se aggiorno un .md di </text:span><text:span text:style-name="T6">progresso / fase non devo </text:span><text:span text:style-name="T6">fare neanche quello. Sa lui </text:span><text:span text:style-name="T6">quale slice / step fare.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Quindi, su VS Code posso </text:span><text:span text:style-name="T6">chiamarli con la shortcut </text:span><text:span text:style-name="T6">/fai_questo.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Quindi, devo solo ridargli lo </text:span><text:span text:style-name="T6">stesso comando.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Il comando legge il file di </text:span><text:span text:style-name="T6">fase, legge l&apos;elenco delle </text:span><text:span text:style-name="T6">fasi, capisce a quale fase </text:span><text:span text:style-name="T6">siamo arrivati.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Crea il prompt, usando un </text:span><text:span text:style-name="T6">template. A seconda della </text:span><text:span text:style-name="T6">fase (es. defrag </text:span><text:span text:style-name="T6">documenti) può anche </text:span><text:span text:style-name="T6">creare un prompt </text:span><text:span text:style-name="T6">specializzato per usare </text:span><text:span text:style-name="T6">sub-agenti.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Task</text:span></text:p>
      <text:p><text:span text:style-name="T6">Contesto</text:span></text:p>
      <text:p><text:span text:style-name="T6">Vincoli</text:span></text:p>
      <text:p><text:span text:style-name="T6">Formato</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Task</text:span></text:p>
      <text:p><text:span text:style-name="T6">Context</text:span></text:p>
      <text:p><text:span text:style-name="T6">Template / Formato</text:span></text:p>
      <text:p><text:span text:style-name="T6">Check</text:span></text:p>
      <text:p><text:span text:style-name="T6">Report</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Il prompt può basarsi su un </text:span><text:span text:style-name="T6">template. Deve contenere </text:span><text:span text:style-name="T6">le istruzioni per il lavoro da </text:span><text:span text:style-name="T6">fare.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Devo poter modificare una </text:span><text:span text:style-name="T6">sezione per indirizzare un </text:span><text:span text:style-name="T6">po&apos; il lavoro (es. questo db </text:span><text:span text:style-name="T6">in json in realtà era dentro </text:span><text:span text:style-name="T6">Oracle, usa gli .xml).</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">In uno scenario come </text:span><text:span text:style-name="T6">questo, l&apos;output non è solo </text:span><text:span text:style-name="T6">un singolo file ma una </text:span><text:span text:style-name="T6">serie di modifiche ad altri </text:span><text:span text:style-name="T6">file. Però vengono prodotti </text:span><text:span text:style-name="T6">anche diversi file di analisi.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Il template sta lì per </text:span><text:span text:style-name="T6">integrare/espandere il </text:span><text:span text:style-name="T6">prompt, nel senso: se devi </text:span><text:span text:style-name="T6">scrivere una analisi / altro </text:span><text:span text:style-name="T6">documento, usa questo </text:span><text:span text:style-name="T6">formato.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Check starebbe lì per </text:span><text:span text:style-name="T6">l&apos;autoverifica. Solo che non </text:span><text:span text:style-name="T6">mi fido che venga fatta </text:span><text:span text:style-name="T6">nella stessa chat. Ma </text:span><text:span text:style-name="T6">potrei mettere da parte la </text:span><text:span text:style-name="T6">mia paranoia in nome della </text:span><text:span text:style-name="T6">semplicità. *Update* pare </text:span><text:span text:style-name="T6">che funzioni, ma con </text:span><text:span text:style-name="T6">vincoli precisi (hai fatto x? </text:span><text:span text:style-name="T6">E y?).</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Quindi, la generazione del </text:span><text:span text:style-name="T6">prompt potrebbe generare </text:span><text:span text:style-name="T6">anche l&apos;autotest. Se ha il </text:span><text:span text:style-name="T6">contesto, può essere </text:span><text:span text:style-name="T6">accurato.</text:span></text:p>
      <text:p><text:span text:style-name="T6"/></text:p>
      <text:p><text:span text:style-name="T6">Infine, la direttiva Report </text:span><text:span text:style-name="T6">(sempre su template) </text:span><text:span text:style-name="T6">istruisce a scrivere un </text:span><text:span text:style-name="T6">resoconto di quello che è </text:span><text:span text:style-name="T6">stato fatto. Che fa anche </text:span><text:span text:style-name="T6">da documentazione e da </text:span><text:span text:style-name="T6">guida per i task successivi. </text:span></text:p>
     </draw:text-box>
    </draw:frame>
    <draw:frame draw:style-name="gr3" draw:text-style-name="P4" xml:id="id7" draw:id="id7" draw:layer="layout" svg:width="5cm" svg:height="5cm" svg:x="166cm" svg:y="109.25cm">
     <draw:text-box>
      <text:p text:style-name="P3"><text:span text:style-name="T1">prompt per la creazione del </text:span><text:span text:style-name="T1">prompt per la slide n</text:span></text:p>
     </draw:text-box>
     <draw:glue-point draw:id="4" svg:x="0cm" svg:y="0cm"/>
    </draw:frame>
