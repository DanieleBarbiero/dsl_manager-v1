    },
    {
      "children": [],
      "content_layer": "body",
      "label": "text",
      "orig": "Gli stati previsti dalla procedura sono BOZZA, VALIDATA, DELIBERATA e ANNULLATA.",
      "parent": {
        "$ref": "#/body"
      },
      "prov": [],
      "self_ref": "#/texts/5",
      "text": "Gli stati previsti dalla procedura sono BOZZA, VALIDATA, DELIBERATA e ANNULLATA."
    },
    {
      "children": [],
      "content_layer": "body",
      "label": "text",
      "orig": "Una pratica può essere deliberata soltanto se l'importo richiesto non supera 50000 euro.",
